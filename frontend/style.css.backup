/* ==========================================================================
   SIH26141 QUANTUM QDS THREAT DETECTION DASHBOARD - CSS STYLESHEET
   Aesthetics: Deep Space Dark Mode, Glassmorphism, Neon Accents & Clean Typography
   ========================================================================== */

:root {
    --bg-base: #080c14;
    --bg-surface: #0e1626;
    --bg-card: rgba(21, 32, 54, 0.7);
    --bg-card-hover: rgba(29, 44, 74, 0.8);
    --border-color: rgba(255, 255, 255, 0.08);
    --border-focus: #00f2fe;

    --text-main: #f1f5f9;
    --text-muted: #94a3b8;
    --text-dim: #64748b;

    --cyan-glow: #00f2fe;
    --cyan-dim: rgba(0, 242, 254, 0.15);
    --purple-glow: #7c3aed;
    --emerald-green: #10b981;
    --emerald-dim: rgba(16, 185, 129, 0.15);
    --rose-red: #ef4444;
    --rose-dim: rgba(239, 68, 68, 0.15);
    --amber-gold: #f59e0b;
    --amber-dim: rgba(245, 158, 11, 0.15);

    --font-primary: 'Inter', system-ui, -apple-system, sans-serif;
    --font-heading: 'Outfit', 'Inter', sans-serif;
    --font-code: 'Fira Code', monospace;

    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --shadow-subtle: 0 4px 20px rgba(0, 0, 0, 0.3);
    --shadow-glow-cyan: 0 0 25px rgba(0, 242, 254, 0.25);
}

/* Reset & Global Base Styles */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-base);
    color: var(--text-main);
    font-family: var(--font-primary);
    line-height: 1.5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-image: 
        radial-gradient(circle at 10% 20%, rgba(0, 242, 254, 0.04) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(124, 58, 237, 0.05) 0%, transparent 40%);
    background-attachment: fixed;
}

/* Header Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: rgba(14, 22, 38, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
}

.brand-container {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.logo-icon {
    font-size: 1.8rem;
    color: var(--cyan-glow);
    animation: rotateSlow 20s linear infinite;
}

@keyframes rotateSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.brand-text h1 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: linear-gradient(135deg, #ffffff 0%, var(--cyan-glow) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.brand-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.header-badges {
    display: flex;
    gap: 0.75rem;
    align-items: center;
}

.badge {
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.04);
}

.sih-badge {
    color: var(--cyan-glow);
    border-color: rgba(0, 242, 254, 0.3);
}

.team-badge {
    color: #a78bfa;
    border-color: rgba(167, 139, 250, 0.3);
}

.status-badge-online {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--emerald-green);
    border-color: rgba(16, 185, 129, 0.3);
    background: var(--emerald-dim);
}

.pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--emerald-green);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--emerald-green);
    animation: pulse 2s infinite;
}

.pulse-dot-dim {
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: var(--text-dim);
    border-radius: 50%;
    margin-right: 4px;
}

.pulse-dot-active {
    display: inline-block;
    width: 7px;
    height: 7px;
    background-color: var(--cyan-glow);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--cyan-glow);
    animation: pulse 1.5s infinite;
    margin-right: 4px;
}

@keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.2); }
    100% { opacity: 1; transform: scale(1); }
}

/* Dashboard Layout */
.dashboard-container {
    max-width: 1440px;
    margin: 1.5rem auto;
    padding: 0 1.5rem;
    width: 100%;
    flex: 1;
}

/* Navigation Tabs */
.tab-nav {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
    overflow-x: auto;
}

.tab-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-primary);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.75rem 1.25rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
}

.tab-btn:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.02);
}

.tab-btn.active {
    color: var(--cyan-glow);
    border-bottom-color: var(--cyan-glow);
    background: rgba(0, 242, 254, 0.05);
}

.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Two-column Workspace Layout */
.workspace-layout {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 1.5rem;
}

@media (max-width: 1024px) {
    .workspace-layout {
        grid-template-columns: 1fr;
    }
}

/* Glass Panels */
.panel {
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-subtle);
}

.panel-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
}

.panel-header h2 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-main);
}

/* Form Controls */
.form-group {
    margin-bottom: 1.25rem;
}

.form-group label {
    display: block;
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
}

.state-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
}

.state-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.5rem;
    color: var(--text-main);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.2s ease;
}

.state-btn .ket {
    font-family: var(--font-code);
    font-size: 1.1rem;
    font-weight: 600;
}

.state-btn .basis-tag {
    font-size: 0.65rem;
    color: var(--text-dim);
}

.state-btn:hover {
    border-color: rgba(0, 242, 254, 0.4);
    background: rgba(0, 242, 254, 0.05);
}

.state-btn.active {
    border-color: var(--cyan-glow);
    background: var(--cyan-dim);
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.2);
}

.form-control {
    width: 100%;
    padding: 0.65rem 0.85rem;
    background: rgba(8, 12, 20, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    font-family: var(--font-primary);
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.2s ease;
}

.form-control:focus {
    border-color: var(--border-focus);
}

.radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.radio-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-main);
    cursor: pointer;
}

.slider-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
}

.slider-val {
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--cyan-glow);
}

input[type="range"] {
    width: 100%;
    accent-color: var(--cyan-glow);
}

/* Action Buttons */
.btn-action-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
}

.btn {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
}

.btn-primary {
    background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
    color: #040914;
    box-shadow: var(--shadow-glow-cyan);
}

.btn-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
}

.btn-sm {
    width: auto;
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
}

/* Status Banner */
.status-banner {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    transition: all 0.3s ease;
}

.status-idle {
    background: rgba(255, 255, 255, 0.02);
    border-color: var(--border-color);
}

.status-valid {
    background: var(--emerald-dim);
    border-color: rgba(16, 185, 129, 0.4);
    color: #34d399;
}

.status-threat {
    background: var(--rose-dim);
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
}

.status-blocked {
    background: var(--amber-dim);
    border-color: rgba(245, 158, 11, 0.4);
    color: #fbbf24;
}

.status-icon {
    font-size: 2rem;
}

.status-details h3 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
}

.status-details p {
    font-size: 0.85rem;
    opacity: 0.85;
}

/* ALICE -> EVE -> BOB COMMUNICATION FLOW STYLES */
.communication-flow-card {
    border-color: rgba(0, 242, 254, 0.25);
    background: rgba(14, 22, 38, 0.95);

}

.nodes-container {
    display: grid;
    grid-template-columns: 1fr 140px 1fr 140px 1fr;
    align-items: center;
    gap: 0.5rem;
    margin: 1.25rem 0;

}

@media (max-width: 900px) {
    .nodes-container {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}

.comm-node {
    background: rgba(8, 12, 20, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;

}

.comm-node.node-active-alice {
    border-color: var(--cyan-glow);
    background: var(--cyan-dim);
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.3);

}

.comm-node.node-active-eve {
    border-color: var(--amber-gold);
    background: var(--amber-dim);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);

}

.comm-node.node-active-bob {
    border-color: #a78bfa;
    background: rgba(167, 139, 250, 0.15);
    box-shadow: 0 0 20px rgba(167, 139, 250, 0.3);

}

.node-avatar {
    font-size: 2.2rem;
    margin-bottom: 0.35rem;
}

.node-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
}

.node-role {
    font-size: 0.725rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
}

.node-details {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 100%;
}

.node-chip {
    font-family: var(--font-code);
    font-size: 0.7rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: var(--cyan-glow);
}

.node-status-sub {
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
    font-style: italic;
}

/* Connectors & Moving Packets */
.comm-connector {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 60px;
}

.comm-arrow-line {
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.1) 0%, var(--cyan-glow) 50%, rgba(255, 255, 255, 0.1) 100%);
    position: relative;
}

.comm-arrow-line::after {
    content: '▶';
    position: absolute;
    right: -4px;
    top: -6px;
    font-size: 0.7rem;
    color: var(--cyan-glow);
}

.comm-packet {
    position: absolute;
    top: 5px;
    background: linear-gradient(135deg, #00f2fe 0%, #7c3aed 100%);
    color: #040914;
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 0.7rem;
    padding: 0.25rem 0.6rem;
    border-radius: 12px;
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.6);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    z-index: 10;
    white-space: nowrap;
}

.packet-sig {
    font-size: 0.6rem;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
}

/* Bob Verification Box */
.bob-verification-card {
    background: rgba(8, 12, 20, 0.85);
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-top: 1rem;
}

.bob-verification-card h4 {
    font-size: 0.85rem;
    color: #c4b5fd;
    margin-bottom: 0.75rem;
}

.bob-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.65rem;
}

.bob-step {
    font-family: var(--font-code);
    font-size: 0.775rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
}

.bob-step-icon {
    font-size: 0.75rem;
    margin-right: 0.3rem;
}

/* WHAT IS ACTUALLY BEING SIMULATED INFO PANEL */
.info-panel-card {
    border-color: rgba(124, 58, 237, 0.3);
    background: rgba(124, 58, 237, 0.03);
}

.info-text {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.85rem;
}

.sim-pipeline-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
}

.sim-chip {
    font-family: var(--font-code);
    font-size: 0.725rem;
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.3);
    color: #c4b5fd;
    padding: 0.25rem 0.55rem;
    border-radius: 12px;
}

.sim-arrow {
    color: var(--cyan-glow);
    font-size: 0.75rem;
}

/* Metrics Cards Grid */
.metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.metric-card {
    background: rgba(8, 12, 20, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
}

.metric-card-accent {
    border-color: rgba(0, 242, 254, 0.3);
    background: rgba(0, 242, 254, 0.03);
}

.metric-label {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.metric-value {
    font-family: var(--font-code);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0.25rem 0;
}

.metric-sub {
    font-size: 0.7rem;
    color: var(--text-dim);
}

/* Section Cards & Histograms */
.section-card {
    background: rgba(8, 12, 20, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1.25rem;
}

.section-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-muted);
}

.histogram-container {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.histogram-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.hist-label {
    font-family: var(--font-code);
    font-size: 0.85rem;
    width: 90px;
}

.bar-outer {
    flex: 1;
    height: 18px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    overflow: hidden;
}

.bar-inner {
    height: 100%;
    border-radius: 10px;
    transition: width 0.4s ease;
}

.bar-cyan {
    background: linear-gradient(90deg, #00f2fe 0%, #4facfe 100%);
}

.bar-purple {
    background: linear-gradient(90deg, #a78bfa 0%, #7c3aed 100%);
}

.hist-count {
    font-family: var(--font-code);
    font-size: 0.85rem;
    width: 45px;
    text-align: right;
    color: var(--cyan-glow);
}

.reason-box {
    font-family: var(--font-code);
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.6;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--cyan-glow);
}

/* Data Tables */
.table-container {
    overflow-x: auto;
    margin-top: 1rem;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
}

.data-table th, .data-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
}

.data-table th {
    background: rgba(0, 0, 0, 0.2);
    color: var(--text-muted);
    font-weight: 600;
}

.data-table td {
    font-family: var(--font-code);
}

.badge-exceeded {
    background: var(--rose-dim);
    color: #f87171;
    border-color: rgba(239, 68, 68, 0.3);
}

.badge-within {
    background: var(--emerald-dim);
    color: #34d399;
    border-color: rgba(16, 185, 129, 0.3);
}

.badge-blocked {
    background: var(--amber-dim);
    color: #fbbf24;
    border-color: rgba(245, 158, 11, 0.3);
}

/* Markdown / Result formatting */
.markdown-output {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
}

.markdown-output pre {
    background: rgba(0, 0, 0, 0.4);
    padding: 1rem;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-family: var(--font-code);
    margin: 1rem 0;
}

.flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.hidden {
    display: none !important;
}

.text-muted { color: var(--text-muted); }
.margin-bottom-lg { margin-bottom: 1.5rem; }

.footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    border-top: 1px solid var(--border-color);
    margin-top: auto;
}
